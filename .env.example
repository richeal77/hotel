# Shared local demo defaults
APP_ENV=local-demo
API_ADDR=:8080
API_DATA_DIR=./data
HTTP_PORT=8080
DATA_DIR=./data
JWT_SECRET=local-demo-secret
MOCK_SMS_CODE=666666
MOCK_WECHAT=true
MOCK_PAYMENT=true
MOCK_NOTIFICATION=true

# Admin web
ADMIN_API_ORIGIN=http://localhost:8080
ADMIN_API_BASE_URL=/api/v1
ADMIN_WEB_PORT=5173

# Miniapp
MINIAPP_API_BASE_URL=http://localhost:8080/api/v1
MINIAPP_LAN_API_BASE_URL=http://192.168.1.100:8080/api/v1

# Integration/production variables. Do not commit real secrets.
# Supply MYSQL_DSN as a mysql driver DSN for an existing database.
# Example shape: user:password@tcp(host:3306)/hotel?charset=utf8mb4&tls=true
MYSQL_DSN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
STAFF_BOOTSTRAP_PASSWORD=
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
