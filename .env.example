# Shared local demo defaults
APP_ENV=local-demo
HTTP_PORT=8080
DATA_DIR=./data
JWT_SECRET=local-demo-secret
MOCK_SMS_CODE=666666
MOCK_WECHAT=true
MOCK_PAYMENT=true
MOCK_NOTIFICATION=true

# Admin web
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_ADMIN_PORT=5173

# Miniapp
MINIAPP_API_BASE_URL=http://localhost:8080/api/v1
MINIAPP_LAN_API_BASE_URL=http://192.168.1.100:8080/api/v1

# Phase 2 reserved variables. Do not commit real secrets.
MYSQL_DSN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
