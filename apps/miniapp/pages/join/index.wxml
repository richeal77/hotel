<view class="page">
  <view class="demo-ribbon">
    <text>演示模式</text>
    <text class="api-mode">验证码 666666 · {{apiModeText}}</text>
  </view>

  <view class="section panel">
    <view class="panel-title">入会信息</view>
    <view class="form-row">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="onInput" />
      <view class="list-meta">{{phoneHint}}</view>
    </view>
    <view class="form-row">
      <text class="label">验证码</text>
      <input class="input" type="number" maxlength="6" value="{{code}}" data-field="code" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="label">昵称</text>
      <input class="input" value="{{nickname}}" data-field="nickname" bindinput="onInput" />
    </view>
    <view class="btn-row">
      <button class="secondary-btn" bindtap="sendCode">获取验证码</button>
      <button class="primary-btn" bindtap="submitJoin">确认入会</button>
    </view>
  </view>

  <view class="section panel">
    <view class="panel-title">入会礼</view>
    <radio-group bindchange="onGiftChange">
      <label class="radio-row" wx:for="{{gifts}}" wx:key="value">
        <radio value="{{item.value}}" checked="{{giftChoice === item.value}}" color="#0f766e" />
        <text>{{item.label}}</text>
      </label>
    </radio-group>
  </view>

  <view class="section panel">
    <view class="panel-title">来源</view>
    <view class="list-meta">source: {{source}}</view>
    <view class="list-meta">scene: {{scene}}</view>
    <view class="list-meta" wx:if="{{referrerMemberId}}">referrer: {{referrerMemberId}}</view>
    <view class="radio-row">
      <switch checked="{{acceptedPrivacy}}" data-field="acceptedPrivacy" bindchange="onSwitchChange" color="#0f766e" />
      <text>已确认隐私政策</text>
    </view>
    <view class="radio-row">
      <switch checked="{{acceptedMemberRule}}" data-field="acceptedMemberRule" bindchange="onSwitchChange" color="#0f766e" />
      <text>已确认会员规则</text>
    </view>
  </view>

  <view class="section panel" wx:if="{{joined}}">
    <view class="panel-title">入会成功</view>
    <view class="list" wx:if="{{issuedCoupons.length}}">
      <view class="card" wx:for="{{issuedCoupons}}" wx:key="id">
        <view class="list-title">{{item.name}}</view>
        <view class="list-meta">{{item.status}}</view>
      </view>
    </view>
    <button class="primary-btn" bindtap="goHome">回首页</button>
  </view>
</view>
