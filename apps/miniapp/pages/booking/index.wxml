<view class="page">
  <view class="demo-ribbon">
    <text>{{apiModeText}}</text>
    <text class="api-mode">暂不支持线上支付</text>
  </view>

  <view class="section panel">
    <view class="panel-title">订房信息</view>
    <view class="form-row">
      <text class="label">入住日期</text>
      <picker mode="date" value="{{checkinDate}}" bindchange="onCheckinChange">
        <view class="picker">{{checkinDate}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="label">离店日期</text>
      <picker mode="date" value="{{checkoutDate}}" bindchange="onCheckoutChange">
        <view class="picker">{{checkoutDate}}</view>
      </picker>
    </view>
    <view class="form-row" wx:if="{{localDemo}}">
      <text class="label">房型</text>
      <picker range="{{roomTypes}}" value="{{roomIndex}}" bindchange="onRoomChange">
        <view class="picker">{{roomTypes[roomIndex]}}</view>
      </picker>
    </view>
    <view wx:if="{{!localDemo && bookingEnabled}}" class="form-row">
      <view class="label">可订房型与价格</view>
      <view class="list-meta" wx:if="{{!rooms.length}}">当前日期暂无可订房型</view>
      <view wx:for="{{rooms}}" wx:key="id" class="room-option">
        <view class="list-title">{{item.name}}</view>
        <view wx:for="{{item.rates}}" wx:for-item="rate" wx:key="id" class="rate-option" bindtap="selectRate" data-rate-id="{{rate.id}}" data-available="{{rate.max_available_rooms}}">
          <text>{{rate.name}} · {{rate.priceText}}/晚 · 余 {{rate.max_available_rooms}} 间</text>
          <text wx:if="{{selectedRateId === rate.id}}">已选</text>
        </view>
      </view>
      <button class="secondary-btn" disabled="{{!selectedRateId || loading}}" bindtap="requestQuote">获取当前报价</button>
    </view>
    <view class="form-row" wx:if="{{quote}}">
      <view class="panel-title">{{quote.room_name}} · {{quoteAmountText}}</view>
      <view class="list-meta">{{quote.night_count}} 晚 · 房费 {{quote.room_total_cent / 100}} 元</view>
      <view class="list-meta">报价有效至 {{quote.expires_at}}</view>
      <view class="list-meta">请核对房型、日期与应付金额后确认预订</view>
    </view>
    <view class="list-meta" wx:if="{{errorText}}">{{errorText}}</view>
    <view class="form-row">
      <text class="label">到店时间</text>
      <picker range="{{arrivalTimes}}" value="{{arrivalIndex}}" bindchange="onArrivalChange">
        <view class="picker">{{arrivalTimes[arrivalIndex]}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="label">联系人</text>
      <input class="input" value="{{contactName}}" data-field="contactName" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{phone}}" disabled="{{!localDemo}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="label">备注</text>
      <textarea class="textarea" value="{{remark}}" data-field="remark" bindinput="onInput" />
    </view>
    <button class="primary-btn" wx:if="{{localDemo || (bookingEnabled && quote)}}" disabled="{{submitting || loading}}" bindtap="submitBooking">确认预订 · 到店付款</button>
    <button class="secondary-btn" wx:if="{{!phone && !localDemo}}" bindtap="goJoin">先授权手机号</button>
  </view>

  <view class="section panel" wx:if="{{createdOrder}}">
    <view class="panel-title">{{localDemo ? createdOrder.status_text : '预订成功，待前台确认'}}</view>
    <view class="list-meta">订单号：{{createdOrder.id}}</view>
    <view class="list-meta">状态：{{createdOrder.status}}</view>
    <button class="secondary-btn order-btn" bindtap="goOrders">查看我的订单</button>
  </view>
</view>
