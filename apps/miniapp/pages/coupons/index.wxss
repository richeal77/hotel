.filter-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.filter {
  padding: 16rpx 6rpx;
  background: #ffffff;
  color: #475569;
}

.filter.active {
  background: #0f766e;
  color: #ffffff;
}

.coupon-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.empty-btn {
  margin-top: 24rpx;
}
