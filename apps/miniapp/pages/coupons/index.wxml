<view class="page">
  <view class="demo-ribbon">
    <text>{{apiModeText}}</text>
    <text class="api-mode">券由前台核销</text>
  </view>

  <view class="section filter-row">
    <button
      wx:for="{{filters}}"
      wx:key="value"
      class="{{activeStatus === item.value ? 'filter active' : 'filter'}}"
      data-status="{{item.value}}"
      bindtap="selectStatus"
    >{{item.label}}</button>
  </view>

  <view class="section" wx:if="{{coupons.length}}">
    <view class="list">
      <view class="card" wx:for="{{coupons}}" wx:key="id">
        <view class="coupon-head">
          <view class="list-title">{{item.name}}</view>
          <text class="badge">{{item.statusText}}</text>
        </view>
        <view class="list-meta">类型：{{item.type}}</view>
        <view class="list-meta">有效期至：{{item.expireText}}</view>
        <view class="list-meta">{{item.use_rule}}</view>
      </view>
    </view>
  </view>

  <view class="section panel empty" wx:else>
    <view>暂无优惠券</view>
    <button class="primary-btn empty-btn" bindtap="goJoin">领取入会礼</button>
  </view>
</view>
